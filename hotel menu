total = 0
print("\n------ MENU ------")
print("1. Idli   - ₹30")
print("2. Dosa   - ₹50")
print("3. Vada   - ₹20")
print("4. Tea    - ₹10")
print("5. Exit")
while True:
 
    choice = int(input("Enter your choice: "))
    if choice == 1:
        qty = int(input("Enter quantity: "))
        total += 30 * qty
        print("Idli added to bill")

    elif choice == 2:
        qty = int(input("Enter quantity: "))
        total += 50 * qty
        print("Dosa added to bill")

    elif choice == 3:
        qty = int(input("Enter quantity: "))
        total += 20 * qty
        print("Vada added to bill")
    elif choice == 4:
        qty = int(input("Enter quantity: "))
        total += 10 * qty
        print("Tea added to bill")
    elif choice == 5:
        print("\nTotal Bill Amount: ₹", total)
        print("Thank you! Visit again 😊")
        break 
    else:
        print("Invalid choice! Please select again.")
